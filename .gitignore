# ==========================================
# .gitignore - Project Mandiri (Undangan Pernikahan Digital)
# ==========================================

# 1. File Sistem Operasi (Windows & macOS)
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# 2. Konfigurasi Editor & IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# 3. File Sementara, Lock, & Backup
~$*
.~lock.*
*.tmp
*.temp
*.bak
*.log

# 4. File Kompresi / Arsip Cadangan
*.zip
*.rar
*.7z
*.tar
*.gz

# 5. Dokumen Pribadi & Pendukung
*.docx
*.doc
*.pdf
*.pptx
*.ppt
*.xlsx
*.xls
